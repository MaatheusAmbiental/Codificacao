# Copie este arquivo para ".env" e preencha com as credenciais do banco HIDRO (SQL Server).
# Fale com a equipe responsável pelo sistema se não tiver esses dados.
# O arquivo ".env" nunca deve ser commitado -- ele já está no .gitignore.

DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Opcional: caminho da pasta insumo (shapefiles/GPKG), se você não quiser copiá-la pra
# dentro da mesma pasta do executável. Pode ser um caminho de rede (ex.: a pasta compartilhada
# da ANA) ou qualquer pasta local -- evita duplicar dados grandes.
# Deixe em branco para usar o padrão: pasta "insumo" ao lado do executável.
# Exemplo (rede):  INSUMO_DIR=\\agencia\ana\SGH\CODIH\Base de Dados Geograficos
# Exemplo (local): INSUMO_DIR=D:\Caminho\Para\insumo
INSUMO_DIR=
